# Comma-separated browser origins permitted to call the API in local development.
CORS_ORIGINS=http://localhost:3000

# Label reported by GET /health.
ENVIRONMENT=development

# PostgreSQL connection for application requests and Alembic migrations.
# Replace the placeholder values locally; never commit real credentials.
DATABASE_URL=postgresql+psycopg://vervio_user:change-me@localhost:5432/vervio

# Authentication session settings. Keep Secure disabled only for local HTTP development.
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=false
# Keep Lax for local and same-site HTTPS deployments. Use None only for a verified
# cross-site deployment over HTTPS, and optionally set a shared parent domain.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Active AI realtime provider: "gemini" or "openai".
AI_REALTIME_PROVIDER=gemini

# OpenAI Realtime is initialized only after an authenticated admin starts an interview.
# Keep this key in backend/.env only; never expose it to the frontend.
OPENAI_API_KEY=
# Current lower-cost Realtime model. Change locally if a different supported model is needed.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Development safeguard. The browser closes an active call at this duration.
OPENAI_INTERVIEW_MAX_DURATION_SECONDS=600

# Gemini Live API settings.
# Keep this key in backend/.env only; never expose it to the frontend.
GEMINI_API_KEY=
# Current supported Gemini Live model with Free Tier access.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Current supported Gemini model for text-based German assessment.
GEMINI_ASSESSMENT_MODEL=gemini-2.5-flash

# Private local-only storage for browser-recorded interview videos. This directory
# is never served as static content; the API checks authentication before playback.
RECORDING_STORAGE_DIR=private-recordings
# 100 MiB is sufficient for the two-minute local demo while limiting uploads.
RECORDING_MAX_UPLOAD_BYTES=104857600

# Recording storage provider: "local" (default) or "cloudflare_r2".
STORAGE_PROVIDER=local

# Cloudflare R2 storage settings (required only when STORAGE_PROVIDER=cloudflare_r2).
# Keep credentials in backend/.env only; never expose them to client code or version control.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
